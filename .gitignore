# Android Studio & Gradle
# ====================================================================
*.iml
.gradle
/build
/*/build
/captures
.externalNativeBuild
.cxx

# Local configuration file (SDK location, etc) - DO NOT COMMIT
local.properties
/local.properties

# Android Studio / IntelliJ Project Files
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/caches
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetDropDown.xml
.idea/deploymentTargetSelector.xml
.idea/deviceManager.xml

# OS Specific
.DS_Store
Thumbs.db

# ====================================================================
# Android Keystore & Security Keys - CRITICAL SECURITY
# ====================================================================
*.jks
*.keystore
key.properties
google-services.json

# ====================================================================
# Java Maven / Bot Demo Artifacts
# ====================================================================
bot_demo/target/
bot_demo/dependency-reduced-pom.xml
*.class

# Sensitive local Bot configuration (Contains API Tokens, AccuWeather Keys)
# Keep config.properties.example committed as a safe template
bot_demo/config.properties
!bot_demo/config.properties.example

# Local SQLite databases generated by Server Bot
bot_demo/data/*.db
bot_demo/data/*.db-journal
bot_demo/data/*.db-shm
bot_demo/data/*.db-wal

# ====================================================================
# Python Crawler Caches
# ====================================================================
**/__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
venv/
